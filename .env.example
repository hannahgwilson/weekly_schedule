# Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Google Calendar IDs (found in GCal Settings > calendar > "Integrate calendar")
GCAL_PERSONAL_ID=hannah@gmail.com
GCAL_FAMILY_ID=family-calendar-id@group.calendar.google.com
GCAL_WORK_ID=hannah@company.com

# Google OAuth credentials file path (download from Google Cloud Console)
GOOGLE_CREDENTIALS_PATH=credentials.json

# Open Brain MCP (optional — enables auto-pull of notes from your Open Brain)
# URL format: https://YOUR_PROJECT_REF.supabase.co/functions/v1/open-brain-mcp?key=YOUR_ACCESS_KEY
OPEN_BRAIN_MCP_URL=

# Supabase — household data (people, events, schedules) lives here.
# SUPABASE_URL is your project URL: https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY is the service-role key (Supabase Dashboard > Project Settings > API)
# DEFAULT_USER_ID is your auth user UUID (same value the family-calendar Edge Function uses)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DEFAULT_USER_ID=
